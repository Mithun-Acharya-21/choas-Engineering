# ChaosEngine AI Configuration
APP_URL="http://localhost:3000"

# Groq Cloud AI Configuration (Milestone M9 Postmortem Synthesis)
# Obtain your key at: https://console.groq.com/keys
LLM_PROVIDER="groq"
GROQ_API_KEY="YOUR_GROQ_API_KEY"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TIMEOUT_SECONDS=15
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Gemini AI (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
